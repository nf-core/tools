nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_taxid"
    profile "test_taxid"


    test("-profile test_taxid") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {


            def stable_content_bracken     = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['bracken/**']      , ignoreFile: 'tests/.nftignore')
            // centrifuge:  partly unstable files, see custom assertions
            def stable_name_all      = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            //blastn
            def stable_content_blastn = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['blast/blastn/**/*'], ignoreFile: 'tests/.nftignore')


            //blastx
            def stable_content_blastx = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['blast/blastx/**/*'], ignoreFile: 'tests/.nftignore')

            //extracted_reads
            def stable_content_extracted_reads = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['extracted_reads/**/*'], ignoreFile: 'tests/.nftignore')

            //def stable_content_igv = getAllFilesFromDir("$outputDir/igv", relative: false, includeDir: false, ignore: null, ignoreFile: 'tests/.nftignore', include: ['*','**/*'])

            //bowtie2 align
            def stable_content_bowtie2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/bowtie2/align'], ignoreFile: 'tests/.nftignore')
            def bam_files_bowtie2_align  = getAllFilesFromDir(params.outdir, include: ['**/**/**/*.bam'])

            //taxpasta
            def stable_content_taxpasta     = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include: ["taxpasta/**"]     , ignoreFile: 'tests/.nftignore')

             //bowtie2 build
            def stable_content_bowtie2_build = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/bowtie2/build/**/**/*'], ignoreFile: 'tests/.nftignore')


            //minimap2
            def stable_content_minimap2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/minimap2/align/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_minimap2_align  = getAllFilesFromDir(params.outdir, include: ['*.bam'])

            //pathogens blast
             def stable_content_pathogens_blast = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/blast/**/*'], ignoreFile: 'tests/.nftignore')

             //pathogens consensus
             def stable_content_pathogens_consensus = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/consensus/*'], ignoreFile: 'tests/.nftignore')

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },

                { assert new File("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastn/kraken2", include: ['*.txt']).collect{file -> file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastn/centrifuge", include: ['*.txt']).collect{file -> file.getName() + '(centrifuge) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastn/diamond", include: ['*.txt']).collect{file -> file.getName() + "(diamond) " + (file.exists() && (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) ? "contains string:true" : file.exists() ? "exists:true" : "exists:false")},
                    stable_content_blastn).match("blastn")},
                 { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastx/kraken2", include: ['*.txt']).collect{file -> file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastx/centrifuge", include: ['*.txt']).collect{file -> file.getName() + "(centrifuge) " + (file.exists() && (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) ? "contains string:true" : file.exists() ? "exists:true" : "exists:false")},
                    stable_content_blastx).match("blastx")},
                { assert snapshot (stable_content_extracted_reads).match("extracted_reads")},
                { assert snapshot (
                    bam_files_bowtie2_align.isEmpty() ? 'No BAM files' : bam_files_bowtie2_align.collect { file -> [file.getName() + " bowtie2 align header: " + bam(file.toString()).getHeader()] },
                    stable_content_bowtie2_align).match("bowtie2_align")},
                { assert snapshot (stable_content_bowtie2_build).match("bowtie2_build")},
                { assert snapshot (
                    bam_files_minimap2_align.isEmpty() ? 'No BAM files' : bam_files_minimap2_align.collect { file -> [file.getName() + " minimap2 align md5: " + bam(file.toString()).getReadsMD5()] },
                    stable_content_minimap2_align).match("minimap2_align")},
                  // igv
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("igv")
                },
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/pathogens/blast/blastn", include: ['*.txt']).collect{file -> file.getName() + ' contains string:' + (file.exists() && file.text.contains("NC_060947.1") || file.text.contains("NC_002023.1_0") || file.text.contains("")) },
                    getAllFilesFromDir("$outputDir/pathogens/blast/blastx", include: ['*.txt']).collect{file -> file.getName() + ' contains string:' + (file.exists() && file.text.contains("NC_002019.1_0")) },
                    stable_content_pathogens_blast).match("pathogens_blast")},
                 { assert snapshot (stable_content_pathogens_consensus).match("pathogens_consensus")},
                 // pathogens igv
                  { assert snapshot(
                        getAllFilesFromDir("$outputDir/pathogens/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("pathogens_igv")
                },
            )
        }
    }

}
