/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // QUALITY CONTROL PROCESSES
    //

    withName: FASTQC {
        ext.args = '--quiet'
        ext.prefix = { "${meta.id}_${meta.taxid}_${meta.tool}" }
        publishDir = [
            path: { "${params.outdir}/fastqc/input" },
            mode: params.publish_dir_mode,
            pattern: '*.{html}'
        ]
    }

    //
    // VERIFY SPECIES
    //

    withName: EXTRACT_VIRAL_TAXID {
        ext.prefix = { "${meta.id}_${meta.tool}" }
        publishDir = [
            path: {"${params.outdir}/viral_taxids" },
            mode: params.publish_dir_mode,
            pattern: '*viral_taxids.tsv'
        ]
    }

    withName: KRAKENTOOLS_EXTRACTKRAKENREADS {
        ext.args = { "--fastq-output --include-children"}
        ext.prefix = { "${meta.id}_${taxid.toString().replaceAll(' ', '-')}" }
        publishDir = [
            path: { "${params.outdir}/extracted_reads/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz',
            enabled: false
        ]
    }

    withName: EXTRACTCENTRIFUGEREADS {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/extracted_reads/centrifuge" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz',
            enabled: false
        ]
    }

    withName: EXTRACTDIAMONDREADS {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/extracted_reads/diamond" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz',
            enabled: false
        ]
    }

    // Convert fastq.gz into fasta
    withName: SEQKIT_FQ2FA_READS {
        //ext.prefix = { "${meta.id}_${meta.taxid}_${meta.tool}"}
        publishDir = [
            enabled: false
        ]
    }

    withName: PIGZ_UNCOMPRESS {
        publishDir = [
            path: { "${params.outdir}/extracted_reads/${meta.tool}/"},
            mode: params.publish_dir_mode,
            pattern: '*.fa'
        ]
    }

    //
    // ASSEMBLY PROCESS
    //

    withName: SPADES {
        ext.args = { "--meta"} // solve uneven coverage across genome
        ext.prefix = { "${meta.id}_${meta.taxid}" }
        publishDir = [
            path: { "${params.outdir}/spades/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa.gz,log,fa}'
        ]
    }

    withName: FLYE {
        ext.prefix = { "${meta.id}_${meta.taxid}" }
        publishDir = [
            path: { "${params.outdir}/flye/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.{fasta,txt,log,json,gfa.gz,gv.gz}'
        ]
    }

    //
    // BLAST PROCESSES
    //

    // Disable publishing for intermediate BLAST database files
    withName: 'UNTAR_BLASTN|UNTAR_BLASTX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:BLAST:BLAST_BLASTN' {
        ext.args = { "-outfmt '6 qseqid sseqid slen pident qlen length qcovs nident evalue bitscore staxid ssciname' -task megablast" }
        ext.prefix = { "${meta.id}_${meta.taxid}_blast" }
        publishDir = [
            path: { "${params.outdir}/blast/blastn/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST:FILTER_BLASTN' {
        ext.args = [
            "--min_qlen ${params.blastn_min_qlen}",
            "--min_pident ${params.blastn_min_pident}",
            "--min_length ${params.blastn_min_length}",
            "--max_evalue ${params.blastn_max_evalue}"
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.taxid}_blast" }
        publishDir = [
            path: { "${params.outdir}/blast/blastn/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST:DIAMOND_BLASTX' {
        ext.prefix = { "${meta.id}_${meta.taxid}_blastx" }
        publishDir = [
            path: { "${params.outdir}/blast/blastx/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST:FILTER_BLASTX' {
        ext.args = [
            "--min_qlen ${params.blastx_min_qlen}",
            "--min_pident ${params.blastx_min_pident}",
            "--min_length ${params.blastx_min_length}",
            "--max_evalue ${params.blastx_max_evalue}"
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.taxid}_blastx" }
        publishDir = [
            path: { "${params.outdir}/blast/blastx/${meta.tool}" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    //
    // MAPPING PROCESS
    //

    // Short-read mapping with Bowtie2
    withName: '.*:MAPPING_SHORTREAD:BOWTIE2_BUILD' {
        publishDir = [
            path: { "$params.outdir/mapping/bowtie2/build/mappingorganism_${meta.organism}/" },
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    withName: '.*:MAPPING_SHORTREAD:PIGZ_UNCOMPRESS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_SHORTREAD:SAMTOOLS_FAIDX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_SHORTREAD:FASTQ_ALIGN_BOWTIE2:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_(SORT|INDEX)' {
        ext.prefix = { "${meta.id}_${meta.tool}_taxid_${meta.taxid}_mappingorganism_${meta.organism}"}
        publishDir = [
            path: { "$params.outdir/mapping/bowtie2/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MAPPING_SHORTREAD_PATHOGEN:FASTQ_ALIGN_BOWTIE2:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_(SORT|INDEX)' {
        publishDir = [
            path: { "$params.outdir/pathogens/mapping/bowtie2/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Long-read mapping with Minimap2
    withName: '.*:MAPPING_LONGREAD:MINIMAP2_INDEX' {
        ext.args = '-x map-ont'
        publishDir = [
            path: { "$params.outdir/mapping/minimap2/index/mappingorganism_${meta.organism}/" },
            mode: params.publish_dir_mode,
            pattern: '*.mmi'
        ]
    }

    withName: '.*:MAPPING_LONGREAD:PIGZ_UNCOMPRESS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_LONGREAD:SAMTOOLS_FAIDX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args = '--sam-hit-only'
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_LONGREAD:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_(SORT|INDEX)' {
        ext.prefix = { "${meta.id}_${meta.tool}_taxid_${meta.taxid}_mappingorganism_${meta.organism}"}
        publishDir = [
            path: { "$params.outdir/mapping/minimap2/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Disable BAM stats publishing
    withName: '.*:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        publishDir = [
            enabled: false
        ]
    }

    //
    // IGV REPORT
    //

    withName: '.*:IGV:IGVREPORTS' {
        ext.prefix = { "${meta.id}_${meta.tool}_taxid_${meta.taxid}_mappingorganism_${meta.organism}" }
        publishDir = [
            path: { "$params.outdir/igv/"},
            mode: params.publish_dir_mode,
            pattern: '*.{fna,fai,bam,bai,html}'
        ]
    }

    withName: '.*:IGV:SAMTOOLS_(VIEW|INDEX|FAIDX)' {
        publishDir = [
            enabled: false
        ]
    }
    withName: '.*:IGV:BEDTOOLS_GENOMECOV' {
        ext.prefix = {"${meta.id}_${meta.tool}_taxid_${meta.taxid}_mappingorganism_${meta.organism}"}
        publishDir = [
            enabled: false
        ]
    }

    //
    // PATHOGEN-SPECIFIC MAPPING
    //

    withName: '.*:MAPPING_SHORTREAD_PATHOGEN:BOWTIE2_BUILD' {
        ext.args = '--large-index'
        publishDir = [
            path: { "$params.outdir/pathogens/mapping/bowtie2/build" },
            mode: params.publish_dir_mode,
            pattern: 'bowtie2'
        ]
    }

    withName: '.*:MAPPING_SHORTREAD_PATHOGEN:PIGZ_UNCOMPRESS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_SHORTREAD_PATHOGEN:SAMTOOLS_FAIDX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_LONGREAD_PATHOGEN:MINIMAP2_INDEX' {
        ext.args = '-x map-ont'
        publishDir = [
            path: { "$params.outdir/pathogens/mapping/minimap2/index" },
            mode: params.publish_dir_mode,
            pattern: '*.mmi'
        ]
    }

    withName: '.*:MAPPING_LONGREAD_PATHOGEN:PIGZ_UNCOMPRESS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_LONGREAD_PATHOGEN:SAMTOOLS_FAIDX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:MAPPING_LONGREAD_PATHOGEN:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_(SORT|INDEX)' {
        ext.prefix = { "${meta.id}_aligned_pathogens_genome_sorted"}
        publishDir = [
            path: { "$params.outdir/pathogens/mapping/minimap2/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // PATHOGEN READ EXTRACTION AND PROCESSING
    //

    withName: '.*:TAXID_BAM_FASTA_(SHORTREAD|LONGREAD):SAMTOOLS_(IDXSTATS|FLAGSTAT)' {
        publishDir = [
            enabled : false
        ]
    }

    withName: '.*:TAXID_BAM_FASTA_(SHORTREAD|LONGREAD):SUBSET_BAM_(PASS|FAIL)' {
        ext.prefix = { "${meta.id}_${meta.taxid}"}
        ext.args = '-bh'
        publishDir = [
            enabled : false
        ]
    }

    // Publish sorted BAM files for consensus calling
    withName: '.*:TAXID_BAM_FASTA_(SHORTREAD|LONGREAD):SAMTOOLS_SORT_PASS' {
        ext.prefix = { "${meta.id}_${meta.organism}_sorted"}
        publishDir = [
            path: { "$params.outdir/pathogens/pathogen_reads/consensus_input/" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam}'
        ]
    }

    withName: '.*:TAXID_BAM_FASTA_(SHORTREAD|LONGREAD):SAMTOOLS_INDEX_PASS' {
        ext.prefix = { "${meta.id}_${meta.organism}_sorted"}
        publishDir = [
            path: { "$params.outdir/pathogens/pathogen_reads/consensus_input/" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai}'
        ]
    }

    // Extract FASTA for BLAST input
    withName: '.*:TAXID_BAM_FASTA_SHORTREAD:SAMTOOLS_FASTA' {
        ext.prefix = { "${meta.id}_${meta.organism}" }
        publishDir = [
            path: { "$params.outdir/pathogens/pathogen_reads/blast_input" },
            mode: params.publish_dir_mode,
            pattern: '*_{1,2}.fasta.gz'
        ]
    }

    withName: '.*:TAXID_BAM_FASTA_LONGREAD:SAMTOOLS_FASTA' {
        ext.prefix = { "${meta.id}_${meta.organism}" }
        publishDir = [
            path: { "$params.outdir/pathogens/pathogen_reads/blast_input" },
            mode: params.publish_dir_mode,
            pattern: '*_1.fasta.gz'
        ]
    }

    // Disable BAM and BAI file publishing
    withName: '.*:TAXID_BAM_FASTA_(SHORTREAD|LONGREAD):SAMTOOLS_(INDEX_FAIL|SORT_FAIL)' {
        publishDir = [
            enabled: false
        ]
    }

    //
    // PATHOGEN-SPECIFIC IGV
    //

    withName: '.*:IGV_PATHOGEN:IGVREPORTS' {
        ext.prefix = { "${meta.id}_${meta.organism}" }
        publishDir = [
            path: { "$params.outdir/pathogens/igv" },
            mode: params.publish_dir_mode,
            pattern: '*.html'
        ]
    }

    withName: '.*:IGV_PATHOGEN:BEDTOOLS_GENOMECOV' {
        ext.prefix = {"${meta.id}_${meta.organism}"}
        publishDir = [
            enabled: false
        ]
    }

    // Disable publishing for pathogen IGV intermediate files
    withName: '.*:IGV_PATHOGEN:SAMTOOLS_(VIEW|INDEX|FAIDX)' {
        publishDir = [
            enabled: false
        ]
    }

    //
    // CONSENSUS CALLING
    //
    withName: '.*:CONSENSUS:SAMTOOLS_CONSENSUS_SHORTREAD' {
        ext.prefix = { "${meta.id}_${meta.organism}_samtools" }
        publishDir = [
            path: { "$params.outdir/pathogens/consensus/" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: '.*:CONSENSUS:MEDAKA' {
        ext.prefix = { "${meta.id}_${meta.organism}_medaka" }
        ext.args1 = '-A'
        ext.args3 = '--no-fillgaps' // Don't fill gaps in consensus with draft sequence
        publishDir = [
            path: { "$params.outdir/pathogens/consensus/" },
            mode: params.publish_dir_mode,
            pattern: '*.fa.gz'
        ]
    }

    withName: '.*:CONSENSUS:SAMTOOLS_CONSENSUS_LONGREAD' {
        ext.prefix = { "${meta.id}_${meta.organism}_samtools" }
        publishDir = [
            path: { "$params.outdir/pathogens/consensus/" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    // Disable publishing for consensus filtering
    withName: '.*:CONSENSUS.FILTER_CONSENSUS_(SHORTREAD|LONGREAD)' {
        ext.prefix = { "${meta.id}_${meta.organism}" }
        publishDir = [
            enabled: false
        ]
    }

    //
    // PATHOGEN-SPECIFIC BLAST ANALYSIS
    //

    withName: '.*:BLAST_PATHOGEN:BLAST_BLASTN' {
        ext.args = { "-outfmt '6 qseqid sseqid slen pident qlen length qcovs nident evalue bitscore staxid scomname' -task megablast" }
        ext.prefix = { "${meta.id}_${meta.organism}_blast" }
        publishDir = [
            path: { "${params.outdir}/pathogens/blast/blastn/" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST_PATHOGEN:FILTER_BLASTN' {
        ext.args = [
            "--min_qlen ${params.blastn_min_qlen}",
            "--min_pident ${params.blastn_min_pident}",
            "--min_length ${params.blastn_min_length}",
            "--max_evalue ${params.blastn_max_evalue}"
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.organism}_blast" }
        publishDir = [
            path: { "${params.outdir}/pathogens/blast/blastn/" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST_PATHOGEN:DIAMOND_BLASTX' {
        ext.prefix = { "${meta.id}_${meta.organism}_blastx" }
        publishDir = [
            path: { "${params.outdir}/pathogens/blast/blastx/" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    withName: '.*:BLAST_PATHOGEN:FILTER_BLASTX' {
        ext.args = [
            "--min_qlen ${params.blastx_min_qlen}",
            "--min_pident ${params.blastx_min_pident}",
            "--min_length ${params.blastx_min_length}",
            "--max_evalue ${params.blastx_max_evalue}"
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.organism}_blastx" }
        publishDir = [
            path: { "${params.outdir}/pathogens/blast/blastx/" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    //
    // UTILITY PROCESSES - DISABLE PUBLISHING
    //

    withName: 'SEQKIT_FQ2FA' {
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:(IGV|IGV_PATHOGEN):PIGZ_UNCOMPRESS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}_aligned_pathogens_genome_sorted"}
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:FASTQ_ALIGN_BOWTIE2:BOWTIE2_ALIGN' {
        ext.args = '--no-unal'
        ext.args2 = '-f 3'
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:FASTQ_ALIGN_BOWTIE2:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        publishDir = [
            enabled: false
        ]
    }

    //
    // REPORTING
    //

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc"},
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
