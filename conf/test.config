/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run genomic-medicine-sweden/metaval -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h',
    ]
}

params {
    config_profile_name         = 'Test profile'
    config_profile_description  = 'Minimal test dataset to check pipeline function'

    // Input data
    input                       = params.pipelines_testdata_base_path + 'samplesheet.csv'
    pathogens_genomes           = params.pipelines_testdata_base_path + 'reference/reference.fasta.gz'
    accession2taxid             = params.pipelines_testdata_base_path + 'reference/accession2taxid.map'
    blastn_db                   = params.pipelines_testdata_base_path + 'blastdb/blastn/blastn_testdb.tar.gz'
    blastx_db                   = params.pipelines_testdata_base_path + 'blastdb/blastx/diamond_testdb.dmnd'

    // Extract reads
    perform_verify_species       = true
    extract_kraken2_reads       = true
    extract_centrifuge_reads    = true
    extract_diamond_reads       = true
    evalue_threshold            = 1e-20

    // de novo
    perform_shortread_denovo    = true
    perform_longread_denovo     = true
    min_read_counts             = 20

    // blast
    skip_blastn                 = false
    skip_blastx                 = false
    blastn_min_qlen             = 50
    blastn_min_pident           = 50
    blastn_min_length           = 50
    blastn_max_evalue           = 0.05
    blastx_min_qlen             = 50
    blastx_min_pident           = 50
    blastx_min_length           = 50
    blastx_max_evalue           = 0.05

    // Mapping
    taxid2genome                = params.pipelines_testdata_base_path + 'genomesdb/taxid2genome.map'
    perform_mapping             = true
    // Screen pathogens
    perform_screen_pathogens    = true
    perform_longread_consensus  = true
    perform_shortread_consensus = true
    longread_consensus_tool     = 'medaka'
    consensus_min_bases         = 50
}
